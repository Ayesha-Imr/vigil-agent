{
  "name": "vigil",
  "version": "0.1.0",
  "description": "An always-on, proactive personal agent built on pi. Reachable from your phone, quiet unless it matters, with formally verified core invariants.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vigil": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types src/cli.ts",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit",
    "verify": "bash verification/run.sh"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
