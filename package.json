{
  "name": "vigil",
  "version": "0.1.0",
  "description": "An always-on, proactive personal agent built on pi. Reachable from your phone, quiet unless it matters, with formally verified core invariants.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vigil": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --experimental-strip-types src/cli.ts",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit",
    "verify": "bash verification/run.sh"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "baileys": "7.0.0-rc14",
    "croner": "^11.0.0",
    "discord.js": "^14.28.1",
    "grammy": "^1.46.0",
    "qrcode-terminal": "^0.12.0",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode-terminal": "^0.12.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "skills",
    "verification",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ayesha-Imr/vigil-agent"
  },
  "keywords": [
    "agent",
    "pi",
    "always-on",
    "proactive",
    "telegram",
    "formal-verification",
    "tla+"
  ]
}
